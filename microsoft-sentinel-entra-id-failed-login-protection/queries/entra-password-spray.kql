// microsoft sentinel - entra id password spray detection
//
// purpose:
//   detect potential password-spray attacks by identifying
//   a source ip generating failed sign-in attempts against
//   multiple different user accounts within a rolling
//   15-minute window.
//
// detection logic:
//   - looks at entra id signinlogs
//   - keeps failed sign-in attempts
//   - groups events by source ip
//   - counts distinct targeted users
//   - triggers when one ip targets multiple accounts
//   - default is reasonably set to 5 or more targeted users. can be adjusted
//
// important:
//   this is an audit/detection query.
//   it does not disable or lock accounts.

SigninLogs
| where TimeGenerated >= ago(15m)
| where ResultType != 0
| where isnotempty(IPAddress)
| where isnotempty(UserPrincipalName)
| summarize
    FailedAttempts = count(),
    TargetedUsers = dcount(UserPrincipalName),
    Users = make_set(UserPrincipalName, 50),
    FirstFailure = min(TimeGenerated),
    LastFailure = max(TimeGenerated),
    Applications = make_set(AppDisplayName, 20),
    FailureReasons = make_set(ResultDescription, 20)
    by IPAddress
| where TargetedUsers >= 5
| project
    IPAddress,
    TargetedUsers,
    FailedAttempts,
    FirstFailure,
    LastFailure,
    Applications,
    FailureReasons,
    Users
| order by TargetedUsers desc, FailedAttempts desc
